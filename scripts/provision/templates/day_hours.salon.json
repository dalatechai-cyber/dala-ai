          { "mode": "not", "matcher": { "mode": "has_word", "words": [
            "үнэ", "une", "үнэтэй", "unetei", "үнийг", "uniig", "үнийн", "uniin",
            "хаяг", "hayag", "hayg", "xayg", "байршил", "bairshil", "baishil", "хаана", "haana",
