# Dala AI — every environment variable the platform reads.
#
# Canonical list: docs/architecture/09-reconciliation.md "Canonical environment variables".
# Guarded by scripts/guards/check-env-example.mjs, which fails if code reads a name that
# is not listed here, or if a name here is never read.
#
# NEVER commit real values. Secrets come from the environment only (CLAUDE.md rule 7).

# ---- Required: the deployment refuses to serve if any is absent ----
DALA_ENV=preview                       # production | staging | preview

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=              # sb_publishable_...  # pending: Track 5 (owner dashboard; ships dormant)

# One named secret key per component, so a leak is scoped and revocable per surface.
SUPABASE_SECRET_WEBHOOK=               # sb_secret_...
SUPABASE_SECRET_WORKER=
SUPABASE_SECRET_ADMIN=  # pending: Track 4
SUPABASE_SECRET_ANALYTICS=  # pending: Phase 3.4
SUPABASE_SECRET_QUALITY=  # pending: Phase 5
SUPABASE_SECRET_PURGE=  # pending: Track 4 (retention)
# The public privacy surface: Meta's data-deletion callback and the status page it hands
# people. Its own key because it is the one surface that is unauthenticated by design AND
# writes a row, so a leak must be revocable without taking Messenger down.
SUPABASE_SECRET_PRIVACY=

# Envelope encryption for per-tenant Meta tokens. 32 bytes, base64.
# There is NO plaintext fallback, ever (CLAUDE.md rule 7).
TENANT_KEK_V1=                         # 32 bytes, base64: node scripts/kek/generate.ts
# REQUIRED, and NOT transient (D-107). V2 is the active version since 2026-09-21, and V1 can
# never be removed: tenant #0's `page_token` row is sealed under v1, `kekForVersion` reads the
# ROW's version, and the V1 value cannot be retrieved from Vercel to put back. Both names are
# uncommented deliberately — preflight derives its required set from the uncommented lines
# here, so dropping either one fails the production deploy instead of a customer's reply.
TENANT_KEK_V2=
TENANT_KEK_ACTIVE_VERSION=v2           # which KEK NEW rows seal under; reads use the row's own

META_APP_ID=  # pending: Track 0.4 (the Meta app). NOT the send path — that needs only the page id and the token
# JSON map {app_slug: secret}. A SET, not a scalar — rotation, staging, and the
# dala-legacy cutover app must all verify concurrently.
META_APP_SECRETS={}
# JSON map {app_slug: token | token[]}
META_VERIFY_TOKENS={}
META_GRAPH_VERSION=v21.0               # default; tenant_channels.graph_version_override wins

# The deployment's own public origin, e.g. https://dala.mn. Used to build the status URL
# returned to Meta's data-deletion callback. NEVER derived from the request's Host header:
# that value is echoed to a third party and then shown to a member of the public.
DALA_PUBLIC_URL=

ANTHROPIC_API_KEY=

# HMAC key for person_identities.value_hash. A PSID is a ~16-digit number, so the whole
# space is 10^16 and a PLAIN hash is brute-forceable — the key is what makes the stored
# value unusable without it. Platform-wide, never per-tenant.
IDENTITY_PEPPER=

# Alert dedup moved to Postgres — a dedup store that fails open is not a dedup store —
# so what these are still for is the §3.5.4 per-conversation mutex, which is not built.
UPSTASH_REDIS_REST_URL=  # pending: §3.5.4 per-conversation mutex
UPSTASH_REDIS_REST_TOKEN=  # pending: §3.5.4
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# ORIGIN ONLY, no path: queue/qstash.ts appends /api/workers/reception and the health
# schedule appends /api/workers/health. A path here is sent twice and QStash posts to a
# 404 while the enqueue reports success.
WORKER_PUBLIC_URL=

LINK_SIGNING_KEY=                      # HMAC key for the booking redirect token  # pending: Phase 3.4
TELEGRAM_BOT_TOKEN=                    # one bot: founder alerts AND per-tenant handoff
TELEGRAM_ALERT_CHAT_ID=
CRON_SECRET=  # pending: Track 4

# ---- Operator-only: never set in Vercel ----
# Read by scripts/publish/tenant.ts and by nothing that serves a request. Export it in your
# own shell for the length of one publish. It is NOT in scripts/preflight.ts's required set
# on purpose — a deploy must not fail for the want of a key no deployed code path reads.
# SUPABASE_SECRET_PUBLISH=              # service_role; compiles and publishes a config revision

# ---- Optional ----
# The website channel (D-086). Commented out, which is what makes them optional: preflight
# derives its REQUIRED set from the uncommented names in this file, so uncommenting either
# one fails every production deploy until it is set in Vercel.
#
# That is the right order. No tenant has a `provider = 'web'` channel, so today the cost of
# their absence is a 500 on a route nobody can reach; once one exists the cost is a silent
# channel, and a refused deploy is the better failure. Uncomment BOTH in the same change
# that provisions the first web channel.
#
# Note what is NOT here: the allowed origins. They are per-tenant data and live in
# `tenant_domains` — this file's own banned list says so.
# CLIENT_IP_SALT=                      # salts the client-IP hash; unsalted, IPv4 is a 2^32 rainbow table
# TURNSTILE_SECRET_KEY=                # Cloudflare Turnstile; the mint fails CLOSED when absent
# TELEGRAM_ALERT_CHAT_ID_CRIT=         # critical alerts only  # pending: Track 2.3
# ALERTS_ENABLED=true                  # false only in dev/CI
#
# The merged 09:00 report (D-128). Unset is the old behaviour exactly: the digest, the flaw
# report and each STILL-OPEN escalation as separate messages, and every warning paged at
# once. `true` sends ONE report and moves the non-actionable warnings into its «Yesterday»
# section. Preflight refuses any value other than `true` or `false`, and refuses `true`
# without DAILY_REPORT_SECRET — the app section would otherwise read UNREADABLE every day.
# DAILY_REPORT_V2=true
# DAILY_REPORT_SECRET=                 # bearer for dalatech-app's /api/daily-report-section; the same value both sides
# DAILY_REPORT_SECTION_URL=            # override only; default https://app.dalatech.online/api/daily-report-section
# ALERT_MAX_PER_HOUR=20  # pending: Track 2.3
# ALERT_DIGEST_HOUR_UB=9  # pending: Track 2.3
# ANTHROPIC_ADMIN_API_KEY=             # read-only, monthly reconciliation only  # pending: monthly reconciliation
# SENTRY_DSN=  # pending: optional, unscheduled

# ---- BANNED as environment variables ----
# Each is per-tenant DATA or a spending decision, and must never be an env var:
#   PAGE_ACCESS_TOKEN  FACEBOOK_PAGE_ID  MESSENGER_VERIFY_TOKEN  SALON_CLOSURE_*
#   ALLOWED_ORIGINS  LOG_WEBHOOK_URL  ANTHROPIC_MODEL
#   PLATFORM_MONTHLY_CEILING_USD and EVERY other ceiling.
#
# Ceilings live in exactly two places, neither an env var:
#   1. config/platform.ts — compiled, commit-gated, approver named in the message
#   2. tenant_budgets     — append-only, and can only ever LOWER the compiled cap
# Enforced by scripts/guards/check-no-ceiling-env.mjs.
