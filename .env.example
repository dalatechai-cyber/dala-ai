# Dala AI — every environment variable the platform reads.
#
# Canonical list: docs/architecture/09-reconciliation.md "Canonical environment variables".
# Guarded by scripts/guards/check-env-example.mjs, which fails if code reads a name that
# is not listed here, or if a name here is never read.
#
# NEVER commit real values. Secrets come from the environment only (CLAUDE.md rule 7).

# ---- Required: the deployment refuses to serve if any is absent ----
DALA_ENV=preview                       # production | staging | preview

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=              # sb_publishable_...  # pending: Track 5 (owner dashboard; ships dormant)

# One named secret key per component, so a leak is scoped and revocable per surface.
SUPABASE_SECRET_WEBHOOK=               # sb_secret_...
SUPABASE_SECRET_WORKER=
SUPABASE_SECRET_ADMIN=  # pending: Track 4
SUPABASE_SECRET_ANALYTICS=  # pending: Phase 3.4
SUPABASE_SECRET_QUALITY=  # pending: Phase 5
SUPABASE_SECRET_PURGE=  # pending: Track 4 (retention)

# Envelope encryption for per-tenant Meta tokens. 32 bytes, base64.
# There is NO plaintext fallback, ever (CLAUDE.md rule 7).
TENANT_KEK_V1=  # pending: Track 2 (token decryption)
TENANT_KEK_ACTIVE_VERSION=v1  # pending: Track 2

META_APP_ID=  # pending: Track 3 (send path)
# JSON map {app_slug: secret}. A SET, not a scalar — rotation, staging, and the
# dala-legacy cutover app must all verify concurrently.
META_APP_SECRETS={}
# JSON map {app_slug: token | token[]}
META_VERIFY_TOKENS={}
META_GRAPH_VERSION=v21.0               # default; per-tenant override is a nullable column  # pending: Track 3 (send path)

ANTHROPIC_API_KEY=  # pending: Track 3 (the model call)

UPSTASH_REDIS_REST_URL=  # pending: Track 2 (alert dedup)
UPSTASH_REDIS_REST_TOKEN=  # pending: Track 2
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
WORKER_PUBLIC_URL=

LINK_SIGNING_KEY=                      # HMAC key for the booking redirect token  # pending: Phase 3.4
TELEGRAM_BOT_TOKEN=                    # one bot: founder alerts AND per-tenant handoff
TELEGRAM_ALERT_CHAT_ID=
CRON_SECRET=  # pending: Track 4

# ---- Optional ----
# TENANT_KEK_V2=                       # present only during rotation  # pending: rotation only
# TELEGRAM_ALERT_CHAT_ID_CRIT=         # critical alerts only  # pending: Track 2.3
# ALERTS_ENABLED=true                  # false only in dev/CI
# ALERT_MAX_PER_HOUR=20  # pending: Track 2.3
# ALERT_DIGEST_HOUR_UB=9  # pending: Track 2.3
# ANTHROPIC_ADMIN_API_KEY=             # read-only, monthly reconciliation only  # pending: monthly reconciliation
# SENTRY_DSN=  # pending: optional, unscheduled

# ---- BANNED as environment variables ----
# Each is per-tenant DATA or a spending decision, and must never be an env var:
#   PAGE_ACCESS_TOKEN  FACEBOOK_PAGE_ID  MESSENGER_VERIFY_TOKEN  SALON_CLOSURE_*
#   ALLOWED_ORIGINS  LOG_WEBHOOK_URL  ANTHROPIC_MODEL
#   PLATFORM_MONTHLY_CEILING_USD and EVERY other ceiling.
#
# Ceilings live in exactly two places, neither an env var:
#   1. config/platform.ts — compiled, commit-gated, approver named in the message
#   2. tenant_budgets     — append-only, and can only ever LOWER the compiled cap
# Enforced by scripts/guards/check-no-ceiling-env.mjs.
